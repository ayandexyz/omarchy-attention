#!/usr/bin/env bash
set -euo pipefail
plugin_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

echo "== AttentionLogic unit tests =="
node "$plugin_root/tests/test_attention_logic.js"

echo
echo "== manifest contract =="
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$plugin_root"
  echo "omarchy plugin validate: passed"
else
  echo "omarchy not installed; skipped"
fi

echo
echo "== qmllint =="
# Advisory: the qmllint shipped on some Omarchy installs exits non-zero without
# printing anything, so only actual messages are treated as findings.
shell_root=${OMARCHY_PATH:-/usr/share/omarchy}/shell
if command -v qmllint >/dev/null 2>&1 && [[ -d $shell_root ]]; then
  lint_output=$(qmllint -I "$shell_root" "$plugin_root/Service.qml" "$plugin_root/BarWidget.qml" 2>&1 || true)
  if [[ -n $lint_output ]]; then
    echo "$lint_output"
    if grep -qi "error" <<<"$lint_output"; then exit 1; fi
  fi
  echo "qmllint: no findings"
else
  echo "qmllint or the Omarchy shell not available; skipped"
fi

echo
echo "== live (only if the shell has the plugin loaded) =="
if command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell io.github.ayandexyz.attention ping 2>/dev/null | grep -q ok; then
  state=$(omarchy-shell io.github.ayandexyz.attention state)
  echo "$state"
  python3 - "$state" <<'PY'
import json, sys
s = json.loads(sys.argv[1])
assert s["socket"].endswith("/glance/attention.sock"), s["socket"]
print("service reachable; daemon:", s["daemon"])
PY
else
  echo "plugin not loaded in a running shell; skipped"
fi

echo
echo "== reconnect after a failed first connect =="
# The shield must recover when it loses the startup race with glanced. See the
# commit that added this, and quickshell-mirror/quickshell#1180: a Quickshell
# Socket whose first connection attempt fails can never be reconnected, so a
# reconnect has to build a new one. Without that fix this test hangs on
# "disconnected" for the whole run.
commons=$shell_root/Commons
if ! command -v quickshell >/dev/null 2>&1; then
  echo "quickshell not installed; skipped"
elif [[ ! -d $commons ]]; then
  echo "the Omarchy shell's Commons module is not available; skipped"
elif [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  echo "no Wayland session (PanelWindow needs a backend); skipped"
else
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  mkdir -p "$work/harness" "$work/run"
  ln -s "$commons" "$work/harness/Commons"
  ln -s "$plugin_root" "$work/harness/Plugin"
  cp "$plugin_root/tests/reconnect/harness.qml" "$work/harness/shell.qml"

  # The socket appears three seconds in, well after the shell has tried and
  # failed to connect to it.
  python3 "$plugin_root/tests/reconnect/fake_daemon.py" "$work/run/attention.sock" 3 \
    >"$work/daemon.log" 2>&1 &
  daemon_pid=$!

  probe=$(GLANCE_RUNTIME_DIR="$work/run" timeout 20 quickshell -p "$work/harness/shell.qml" 2>&1 |
    grep -E "^.*PROBE" || true)
  kill "$daemon_pid" 2>/dev/null || true
  wait "$daemon_pid" 2>/dev/null || true

  if [[ -z $probe ]]; then
    echo "the harness produced no output; is Service.qml loadable?" >&2
    exit 1
  fi
  if ! grep -q "daemon=tracking" <<<"$probe"; then
    echo "$probe" | tail -5 >&2
    echo "never reconnected after the daemon appeared" >&2
    exit 1
  fi
  echo "reconnected once the daemon appeared"
fi

echo
echo "all tests passed"
